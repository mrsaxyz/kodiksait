{
  "info": {
    "name": "ЛР4 — CodeSlicer Learning API (5 запросов)",
    "description": "Импортируйте коллекцию в Postman. Для GET по id, PUT и DELETE сначала выполните POST и скопируйте полученный id в переменную createdId. На защите покажите: GET список с фильтром, POST, GET по id, PUT, DELETE и итоговый GET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8001" },
    { "key": "createdId", "value": "4" }
  ],
  "item": [
    {
      "name": "01 GET — список проектов + фильтр",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/projects?search=CodeSlicer" }
    },
    {
      "name": "02 GET — проект по ID",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/projects/{{createdId}}" }
    },
    {
      "name": "03 POST — новый проект",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "if (pm.response.code === 201) {",
          "  pm.collectionVariables.set('createdId', pm.response.json().id);",
          "}"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"New analysis workspace\",\n  \"language\": \"Go\",\n  \"description\": \"Тестовый проект для ЛР4\"\n}" },
        "url": "{{baseUrl}}/api/projects"
      }
    },
    {
      "name": "04 PUT — обновить проект",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated analysis workspace\",\n  \"language\": \"Go\",\n  \"description\": \"Проект изменён через PUT\"\n}" },
        "url": "{{baseUrl}}/api/projects/{{createdId}}"
      }
    },
    {
      "name": "05 DELETE — удалить проект",
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/projects/{{createdId}}" }
    }
  ]
}
